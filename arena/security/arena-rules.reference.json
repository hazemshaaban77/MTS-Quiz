{
  "rules": {
    "arenaV1": {
      ".read": false,
      ".write": false,
      "trainerAllowlist": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true)",
          ".write": false
        }
      },
      "rooms": {
        "$roomId": {
          ".read": false,
          ".write": false,
          "public": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true",
            ".validate": "newData.hasChildren(['title', 'status', 'round', 'question', 'options', 'deadline', 'joinOpen'])",
            "title": {".validate":"newData.isString() && newData.val().length <= 120"},
            "status": {".validate":"newData.isString() && (newData.val() === 'lobby' || newData.val() === 'question' || newData.val() === 'between' || newData.val() === 'completed')"},
            "round": {".validate":"newData.isString() && newData.val().matches(/^r[0-9]+$/)"},
            "question": {".validate":"newData.isString() && newData.val().length <= 1000"},
            "options": {".validate":"newData.hasChildren(['0', '1'])"},
            "deadline": {".validate":"newData.isNumber() && newData.val() >= 0"},
            "joinOpen": {".validate":"newData.isBoolean()"},
            "$other": {".validate":false}
          },
          "private": {
            ".read": "auth != null && root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true",
            ".write": "auth != null && root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true"
          }
        }
      },
      "claims": {
        "$roomId": {
          "$employeeId": {
            ".read": "auth != null && (!data.exists() || data.val() === auth.uid || root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true)",
            ".write": "auth != null && !data.exists() && newData.isString() && newData.val() === auth.uid && $employeeId.matches(/^[A-Z0-9_-]{2,20}$/) && root.child('arenaV1/rooms').child($roomId).child('public/joinOpen').val() === true",
            ".validate": "newData.isString()"
          }
        }
      },
      "participants": {
        "$roomId": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true)",
            ".write": "auth != null && (root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true || (auth.uid === $uid && !data.exists() && root.child('arenaV1/rooms').child($roomId).child('public/joinOpen').val() === true && root.child('arenaV1/claims').child($roomId).child(newData.child('employeeId').val()).val() === auth.uid && newData.child('joinedRound').val() === root.child('arenaV1/rooms').child($roomId).child('public/round').val()))",
            ".validate": "newData.hasChildren(['name', 'employeeId', 'joinedRound'])",
            "name": {".validate":"newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"},
            "employeeId": {".validate":"newData.isString() && newData.val().matches(/^[A-Z0-9_-]{2,20}$/)"},
            "joinedRound": {".validate":"newData.isString() && newData.val().matches(/^r[0-9]+$/)"},
            "$other": {".validate":false}
          }
        }
      },
      "answers": {
        "$roomId": {
          "$round": {
            ".read": "auth != null && root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true",
            "$uid": {
              ".read": "auth != null && (auth.uid === $uid || root.child('arenaV1/trainerAllowlist').child(auth.uid).val() === true)",
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('arenaV1/participants').child($roomId).child(auth.uid).exists() && root.child('arenaV1/rooms').child($roomId).child('public/status').val() === 'question' && root.child('arenaV1/rooms').child($roomId).child('public/round').val() === $round && root.child('arenaV1/participants').child($roomId).child(auth.uid).child('joinedRound').val() !== $round && now <= root.child('arenaV1/rooms').child($roomId).child('public/deadline').val()",
              ".validate": "newData.hasChildren(['choice'])",
              "choice": {".validate":"newData.isNumber() && newData.val() >= 0 && newData.val() < root.child('arenaV1/rooms').child($roomId).child('public/options').numChildren()"},
              "$other": {".validate":false}
            }
          }
        }
      }
    }
  }
}